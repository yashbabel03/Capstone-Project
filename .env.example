# --- Core ---
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27017/restaurantops
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
COOKIE_SECURE=false
INTERNAL_AI_KEY=change-me-internal-service-key

# --- AI service ---
AI_SERVICE_URL=http://127.0.0.1:8002
AI_HOST=0.0.0.0
AI_PORT=8002
CHROMA_PATH=./data/chroma
UPLOAD_DIR=./data/uploads

# Optional LLM (OpenAI-compatible). If empty, extractive grounded answers are used.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
